{
  "name": "view-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "build": "electron-vite build",
    "test:e2e": "electron-vite build && playwright test",
    "package:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "snapshots:update": "vitest run --config vitest.update.config.ts",
    "snapshots:png": "vitest run --config vitest.png.config.ts"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/carbon": "1.2.29",
    "@iconify-json/lucide": "1.2.150",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/qlementine-icons": "1.2.16",
    "@iconify/react": "6.0.4",
    "@pascal-app/core": "1.1.4",
    "@pascal-app/editor": "1.1.4",
    "@pascal-app/nodes": "1.1.4",
    "@pascal-app/viewer": "1.1.4",
    "@playwright/test": "1.65.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fast-check": "4.10.2",
    "i18next": "27.1.1",
    "immer": "11.2.10",
    "lucide-react": "1.66.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.187.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "main": "out/main/index.js"
}
