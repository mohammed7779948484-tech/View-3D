index 0000000..16e16d6
--- /dev/null
+++ b/test/layout/free-counter.test.ts
@@ -0,0 +1,188 @@
+/**
+ * Issue M3-10d: the checkout block (counter plus showcases in one straight line) may also stand
+ * in open floor near the entrance, not only parallel to a wall.
+ *
+ * ORACLE: the hand-worked room below (distances from the drawing, in mm), validateLayout, and the
+ * independent judge in test/oracle (keep-clear areas written out by hand, as in oracle.test.ts).
+ * The brute-force search (200 mm grid, quarter turns) found valid counter spots 1947 mm (angled
+ * entrance, counter alone) and 1789 mm (glass shop) from the entrance. With its showcase in the
+ * same line the nearest valid block centre on the angled entrance is about 3100 mm, so that bound
+ * is 3200 mm (not 3000, which came from the counter alone); the glass shop bound is 2500 mm.
+ * Decision (a), docs/NOTES.md 2026-11-12 (16): the open-floor block stands IN PLACE OF the third
+ * counter wall, so the number of blocks (and the time) does not change. The angled entrance is judged by validateLayout only: its keep-clear areas on an angled wall
+ * are not worked out by hand in test/oracle.
+ */
+import { describe, expect, it } from 'vitest';
+import type { DesignDocument, Opening, Point, Room } from '../../src/core/index';
+import { toUm } from '../../src/core/index';
+import { autoLayout } from '../../src/layout/index';
+import type { LayoutOption, LayoutRequest } from '../../src/layout/index';
+import { validateLayout } from '../../src/rules/index';
+import { judge } from '../oracle/oracle';
+import type { Box, KeepClear } from '../oracle/oracle';
+import { testCounterLong, testGondolaDouble, testShowcase, testWallShelf } from '../fixtures/products';
+import { angledEntrance, angledEntranceRoom, scenarios, wallsFull } from './scenarios';
+
+const mm = (v: number): number => toUm(v, 'mm');
+const item = (product: (typeof testCounterLong), quantity: number) => ({ product, variantId: product.variants[0]!.id, quantity });
+const box = (x0: number, y0: number, x1: number, y1: number): Box => ({ x0: mm(x0), y0: mm(y0), x1: mm(x1), y1: mm(y1) });
+
+/** Entrance midpoint from the room alone: the opening's wall, offset + width / 2 along the wall. */
+function entranceMidpoint(room: Room): Point {
+  const o = room.openings.find((x) => x.kind === 'door' && x.door?.isEntrance === true)!;
+  const a = room.outline[o.wallIndex]!;
+  const b = room.outline[(o.wallIndex + 1) % room.outline.length]!;
+  const len = Math.hypot(b.x - a.x, b.y - a.y);
+  const t = (o.offsetUm + o.widthUm / 2) / len;
+  return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
+}
+const counterCentre = (doc: DesignDocument): Point =>
+  doc.placements.find((p) => p.productId === testCounterLong.id)!.center;
+const distanceMm = (a: Point, b: Point): number => Math.hypot(a.x - b.x, a.y - b.y) / 1000;
+const freeOptions = (options: readonly LayoutOption[]) => options.filter((o) => o.strategy.counterFree);
+
+// ---- the glass-fronted corner shop: 8000 x 6000, entrance at x 3500..4500 on the bottom wall ----
+const win = (id: string, wallIndex: number, offset: number, width: number): Opening => ({
+  id, kind: 'window', wallIndex, offsetUm: mm(offset), widthUm: mm(width), heightUm: mm(2000), sillHeightUm: mm(300),
+});
+const glassRoom: Room = {
+  outline: [{ x: 0, y: 0 }, { x: mm(8000), y: 0 }, { x: mm(8000), y: mm(6000) }, { x: 0, y: mm(6000) }],
+  ceilingHeightUm: mm(3000),
+  columns: [],
+  openings: [
+    { id: 'entrance', kind: 'door', wallIndex: 0, offsetUm: mm(3500), widthUm: mm(1000), heightUm: mm(2100), sillHeightUm: 0, door: { isEntrance: true, swing: 'in', hinge: 'start' } },
+    win('w0a', 0, 0, 3400),
+    win('w0b', 0, 4600, 3400),
+    win('w1', 1, 0, 3500),
+    win('w3', 3, 2500, 3500),
+  ],
+};
+const glassShop: LayoutRequest = {
+  id: 'glass-corner-shop',
+  name: 'Glass-fronted corner shop (test fixtures)',
+  room: glassRoom,
+  items: [item(testCounterLong, 1), item(testShowcase, 2), item(testGondolaDouble, 2), item(testWallShelf, 2)],
+};
+/**
+ * Keep-clear by hand for the entrance x 3500..4500 on the bottom wall, hinged left, swinging in:
+ * swing quarter disc r 1000 at (3500, 0); approach x 3500..5000 (width + 455), 1525 deep;
+ * decompression x 3500..4500, min(3000, 6000 / 3) = 2000 deep.
+ */
+const glassKeepClear: KeepClear[] = [
+  { name: 'entrance swing', boxes: [], discs: [{ cx: mm(3500), cy: 0, r: mm(1000), within: box(3500, 0, 4500, 1000) }] },
+  { name: 'entrance approach', boxes: [box(3500, 0, 5000, 1525)], discs: [] },
+  { name: 'entrance decompression', boxes: [box(3500, 0, 4500, 2000)], discs: [] },
+];
+/**
+ * Window bands (600 mm into the room). Wall 0 runs along y = 0 from x = 0: x 0..3400 and 4600..8000.
+ * Wall 1 runs up x = 8000: offset 0..3500 is y 0..3500. Wall 3 runs down x = 0 from (0, 6000):
+ * offset 2500..6000 is y 3500..0.
+ */
+const glassWindows = [
+  { name: 'w0a', band: box(0, 0, 3400, 600), sillUm: mm(300) },
+  { name: 'w0b', band: box(4600, 0, 8000, 600), sillUm: mm(300) },
+  { name: 'w1', band: box(7400, 0, 8000, 3500), sillUm: mm(300) },
+  { name: 'w3', band: box(0, 0, 600, 3500), sillUm: mm(300) },
+];
+
+describe('free-standing checkout block: angled entrance', () => {
+  const result = autoLayout(angledEntrance);
+  const mid = entranceMidpoint(angledEntranceRoom);
+
+  it('has an option with the counter in open floor, at most 3200 mm from the entrance', () => {
+    const free = freeOptions(result.options);
+    expect(free.length).toBeGreaterThan(0);
+    for (const o of free) {
+      expect(o.strategy.counterWall).toBeNull();
+      expect(o.strategy.id.startsWith('counter-free_')).toBe(true);
+    }
+    const nearest = Math.min(...free.map((o) => distanceMm(counterCentre(o.document), mid)));
+    expect(nearest).toBeLessThanOrEqual(3200);
+  });
+
+  it('every option passes validateLayout', () => {
+    expect(result.options.length).toBeGreaterThan(0);
+    for (const o of result.options) expect(validateLayout(o.document), o.strategy.id).toEqual([]);
+  });
+
+  it('is deterministic: two runs give identical JSON', () => {
+    expect(JSON.stringify(autoLayout(angledEntrance))).toBe(JSON.stringify(result));
+  });
+});
+
+describe('free-standing checkout block: glass-fronted corner shop', () => {
+  const options = autoLayout(glassShop).options;
+  const mid = entranceMidpoint(glassRoom);
+
+  it('the entrance midpoint is (4000, 0) mm', () => {
+    expect(mid).toEqual({ x: mm(4000), y: 0 });
+  });
+
+  it('has a counter-free option with the counter at most 2500 mm from the entrance', () => {
+    const free = freeOptions(options);
+    expect(free.length).toBeGreaterThan(0);
+    for (const o of free) {
+      expect(o.strategy.counterWall).toBeNull();
+      expect(o.strategy.id.startsWith('counter-free_')).toBe(true);
+    }
+    const nearest = Math.min(...free.map((o) => distanceMm(counterCentre(o.document), mid)));
+    expect(nearest).toBeLessThanOrEqual(2500);
+  });
+
+  it('every option passes validateLayout and the independent oracle', () => {
+    expect(options.length).toBeGreaterThan(0);
+    for (const o of options) {
+      expect(validateLayout(o.document), o.strategy.id).toEqual([]);
+      expect(judge(o.document, glassKeepClear, glassWindows, { at: { x: mm(4000), y: 0 }, inward: { x: 0, y: 1 } }), o.strategy.id).toEqual([]);
+    }
+  });
+
+  it('option 1 places at least as many fixtures as any option', () => {
+    const counts = options.map((o) => o.document.placements.length);
+    expect(counts[0]).toBe(Math.max(...counts));
+  });
+});
+
+describe('free-standing checkout block: only with a counter', () => {
+  it('a request without a counter has no counterFree option', () => {
+    const noCounter: LayoutRequest = { ...wallsFull, id: 'walls-full-no-counter', items: wallsFull.items.filter((i) => i.product.placement !== 'counter') };
+    expect(noCounter.items.length).toBe(wallsFull.items.length - 1);
+    const options = autoLayout(noCounter).options;
+    expect(options.length).toBeGreaterThan(0);
+    for (const o of options) {
+      expect(o.strategy.counterFree, o.strategy.id).toBe(false);
+      expect(o.strategy.id.startsWith('counter-none_')).toBe(true);
+    }
+  });
+
+  it.each([...scenarios, angledEntrance, wallsFull].map((r) => [r.id, r] as const))(
+    '%s: counterFree is a boolean on every option, and true implies no counter wall',
+    (_id, request) => {
+      const options = autoLayout(request).options;
+      expect(options.length).toBeGreaterThan(0);
+      for (const o of options) {
+        expect(typeof o.strategy.counterFree, o.strategy.id).toBe('boolean');
+        if (o.strategy.counterFree) {
+          expect(o.strategy.counterWall).toBeNull();
+          expect(o.strategy.id.startsWith('counter-free_')).toBe(true);
+        } else if (o.strategy.counterWall !== null) {
+          expect(o.strategy.id.startsWith(`counter-wall-${o.strategy.counterWall}_`)).toBe(true);
+        }
+      }
+    },
+  );
+});
+
+describe('free-standing checkout block: same number of search blocks as today', () => {
+  /** By hand: 3 counter walls tried x 2 row directions = 6 with a counter; one null block x 2 = 2 without. */
+  it.each([...scenarios, angledEntrance, wallsFull].map((r) => [r.id, r] as const))(
+    '%s: onProgress total is 6 with a counter, 2 without',
+    (_id, request) => {
+      const totals: number[] = [];
+      autoLayout(request, { onProgress: (_d: number, t: number) => void totals.push(t) });
+      const hasCounter = request.items.some((i) => i.product.placement === 'counter');
+      expect(totals.length).toBeGreaterThan(0);
+      for (const t of totals) expect(t).toBe(hasCounter ? 6 : 2);
+    },
+  );
+});
